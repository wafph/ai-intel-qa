# 开发环境：统一请求 V12 后端，Vite 将 /api 转发到 8000。
VITE_API_BASE_URL=/api

# 默认 platform：用户名密码登录走 /v1/agent-permission/platform-login，前端先用 SM2 加密 password。
# 如需本地账号体系测试，可改为 local，此时走 /v1/auth/login。
VITE_AUTH_MODE=platform

# 集团统一 SM2 公钥。请替换为真实完整公钥。
VITE_SM2_PUBLIC_KEY=049936f3937f9362bb4d0c1f88c4e86ae12e4d1441b25e9281401274a4e0bfdcfe6c7b8bdd47aa2e86a49cc658e59fa89ebc222140d78520620848bd773edc98fe

# 第三方 agentToken 前端会话有效期，单位分钟。
VITE_AGENT_SESSION_EXPIRE_MINUTES=720

# 开发环境：水印下载接口通过 Vite 代理到 8005，最终后端请求：
# http://1.94.244.72:8005/v1/files/watermark/download
VITE_WATERMARK_API_BASE_URL=/watermark-api

# 开发环境：Markdown 转 Word 通过 Vite 代理到 8005，最终后端请求：
# http://1.94.244.72:8005/v1/markdown-word/convert
VITE_CONVERT_API_BASE_URL=/markdown-word-api

# 智能审核文件上传接口配置。
# 为避免浏览器直连 HTTPS 自签名证书导致 ERR_CERT_AUTHORITY_INVALID，开发环境默认走 Vite 代理。
# 代码会自动拼接：?workspace_id=${VITE_AGENT_UPLOAD_WORKSPACE_ID}
# 最终后端请求：
# https://10.210.101.211:31113/v1/b2eb6baae0e349538172fcb9a4401145/agent-runtime/upload-file?workspace_id=ea92d52f11e74688ae50854f42f4f74f
VITE_AGENT_UPLOAD_API_BASE_URL=/review-upload-api/v1/b2eb6baae0e349538172fcb9a4401145/agent-runtime/upload-file
VITE_AGENT_UPLOAD_WORKSPACE_ID=ea92d52f11e74688ae50854f42f4f74f

# 智能审核 PDF 预处理接口：仅 PDF 文件走该接口，非 PDF 保持原上传逻辑。
VITE_REVIEW_PDF_PREPARE_API_BASE_URL=/review-pdf-api/v1/review/pdf

# 智能体请求失败时前端统一兆底文案，避免暴露上游 Redis/AgentArts 原始错误。
VITE_FRONTEND_FALLBACK_ERROR_MESSAGE=抱歉，当前智能体服务繁忙或请求处理失败，请稍后重试。

# IAM 认证配置（仅开发环境）。
# 生产环境应由后端代理获取 Token，前端不应直连 IAM。
VITE_IAM_DOMAIN=hid_b5htrig1x-jcljn
VITE_IAM_USERNAME=agent-dev05
VITE_IAM_PASSWORD=agent202605
