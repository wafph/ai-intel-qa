# 开发环境：登录管理/历史记录等后台接口走 /api 代理到 8000
VITE_API_BASE_URL=/api
# 开发环境：/v1/scopes 默认也走 /api；如 scopes 后端不在 8000，可改为单独代理前缀
VITE_SCOPES_API_BASE_URL=/api
# 第三方 agentToken 前端会话有效期，单位分钟，默认与后端登录 token 保持 12 小时
VITE_AGENT_SESSION_EXPIRE_MINUTES=720

# 开发环境：水印下载接口代理到 11328，最终请求 /watermark/download
VITE_WATERMARK_API_BASE_URL=/watermark-api
