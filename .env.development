# 开发环境：统一请求 V12 后端，Vite 将 /api 转发到 8000。
VITE_API_BASE_URL=/api

# 默认 platform：用户名密码登录走 /v1/agent-permission/platform-login，前端先用 SM2 加密 password。
# 如需本地账号体系测试，可改为 local，此时走 /v1/auth/login。
VITE_AUTH_MODE=platform

# 集团统一 SM2 公钥。请替换为真实完整公钥。
VITE_SM2_PUBLIC_KEY=049936f3937f9362bb4d0c1f88c4e86ae12e4d1441b25e9281401274a4e0bfdcfe6c7b8bdd47aa2e86a49cc658e59fa89ebc222140d78520620848bd773edc98fe

# 第三方 agentToken 前端会话有效期，单位分钟。
VITE_AGENT_SESSION_EXPIRE_MINUTES=720

# 开发环境：Vite 显式代理到自建后端 10.210.101.117:8000。
# 最终后端路径：/v1/files/watermark/download；目标地址在 vite.config.ts 修改。
VITE_WATERMARK_API_BASE_URL=/watermark-api

# 开发环境：Vite 显式代理到自建后端 10.210.101.117:8000。
# 最终后端路径：/v1/markdown-word/convert；目标地址在 vite.config.ts 修改。
VITE_CONVERT_API_BASE_URL=/markdown-word-api

# 统一上传走 VITE_API_BASE_URL 下的 qa/review/upload-file；无需前端配置平台。
# 以下为停用的外部直传配置，只保留供维护比对，不参与当前主流程。
# VITE_AGENT_UPLOAD_API_BASE_URL=/review-upload-api/v1/b2eb6baae0e349538172fcb9a4401145/agent-runtime/upload-file
# VITE_AGENT_UPLOAD_WORKSPACE_ID=ea92d52f11e74688ae50854f42f4f74f

# 智能审核 PDF 预处理接口：仅 PDF 文件走该接口，非 PDF 直接经后端统一上传。
VITE_REVIEW_PDF_PREPARE_API_BASE_URL=/review-pdf-api/v1/review/pdf

# 智能体请求失败时前端统一兆底文案，避免暴露上游 Redis/AgentArts 原始错误。
VITE_FRONTEND_FALLBACK_ERROR_MESSAGE=抱歉，当前智能体服务繁忙或请求处理失败，请稍后重试。

# 旧开发 IAM 配置已停用，仅留作比对；不参与 Vite 编译。
# 两平台上传凭证均由后端管理，不恢复前端自动获取。
# VITE_IAM_DOMAIN=hid_b5htrig1x-jcljn
# VITE_IAM_USERNAME=agent-dev05
# VITE_IAM_PASSWORD=agent202605

# 统一上传与 URL 刷新跟随 VITE_API_BASE_URL，不新增前端平台开关。
# AgentArts/AgentOS、上传地址、workspace 和平台凭证统一在后端 .env 配置。

# 外部起草仅使用该入口独立校验的用户 token，不复用内部登录缓存。
# 允许嵌入的主系统 origin，多个用英文逗号分隔，包含协议与端口，不填写页面路径。
# 留空时绑定实际父窗口来源；生产建议填写主系统真实 origin。
VITE_ALLOWED_PARENT_ORIGINS=
# 等待第三方草稿入库回执的最长时间（毫秒）；超时不显示已保存。
VITE_EXTERNAL_DRAFT_ACK_TIMEOUT_MS=30000

# 以下 DEV_* 值仅兼容保留，本版 vite.config.ts 不再读取，不是生效的代理地址来源。
# 自建后端 IP/端口直接修改 vite.config.ts 中各 target，并重启 npm run dev。
DEV_BACKEND_TARGET=http://10.210.101.117:8000
# 历史文件工具与 PDF 目标保留；独立部署时修改 vite.config.ts 中对应 target。
DEV_FILE_TOOL_TARGET=http://10.210.101.117:8000
DEV_REVIEW_PDF_TARGET=http://10.210.101.117:8000
# 仅开发模式：经 vite.config.ts 的 /external-file-download 显式代理读取 DOCX，避免跨域。
VITE_EXTERNAL_DOWNLOAD_PROXY=/external-file-download
