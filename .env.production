# 生产环境：留空，统一走当前 Nginx 同源代理 /v1/...。
VITE_API_BASE_URL=

# 默认 platform：用户名密码登录走 /v1/agent-permission/platform-login，前端先用 SM2 加密 password。
VITE_AUTH_MODE=platform

# 集团统一 SM2 公钥。请替换为真实完整公钥。
VITE_SM2_PUBLIC_KEY=049936f3937f9362bb4d0c1f88c4e86ae12e4d1441b25e9281401274a4e0bfdcfe6c7b8bdd47aa2e86a49cc658e59fa89ebc222140d78520620848bd773edc98fe

VITE_AGENT_SESSION_EXPIRE_MINUTES=720

# 文档服务统一切换到 8005。下面配置的是“路由前缀”，代码会自动追加固定接口路由。
# 最终水印下载请求：
#   http://1.94.244.72:8005/v1/files/watermark/download
# 最终 Markdown 转 Word 请求：
#   http://1.94.244.72:8005/v1/markdown-word/convert
# 后期更换服务器时，优先只替换 IP、端口或前缀；如果改为同源 Nginx 转发，也可写成 /v1/files 和 /v1/markdown-word。
#VITE_WATERMARK_API_BASE_URL=http://1.94.244.72:8005/v1/files
#VITE_CONVERT_API_BASE_URL=http://1.94.244.72:8005/v1/markdown-word
# VITE_WATERMARK_API_BASE_URL=http://10.210.101.209:8005/v1/files
# VITE_CONVERT_API_BASE_URL=http://10.210.101.209:8005/v1/markdown-word
VITE_WATERMARK_API_BASE_URL=/v1/files
VITE_CONVERT_API_BASE_URL=/v1/markdown-word

# 统一上传走 VITE_API_BASE_URL 下的 qa/review/upload-file；无需前端配置平台。
# 以下为停用的外部直传配置，只保留供维护比对，不参与当前主流程。
# VITE_AGENT_UPLOAD_API_BASE_URL=/review-upload-api/v1/b2eb6baae0e349538172fcb9a4401145/agent-runtime/upload-file
# VITE_AGENT_UPLOAD_WORKSPACE_ID=ea92d52f11e74688ae50854f42f4f74f

# 智能审核 PDF 预处理接口：仅 PDF 文件走该接口，非 PDF 直接经后端统一上传。
VITE_REVIEW_PDF_PREPARE_API_BASE_URL=/review-pdf-api/v1/review/pdf

# 智能体请求失败时前端统一兜底文案，避免暴露上游 Redis/AgentArts 原始错误。
VITE_FRONTEND_FALLBACK_ERROR_MESSAGE=抱歉，当前智能体服务繁忙或请求处理失败，请稍后重试。

# 统一上传与 URL 刷新跟随 VITE_API_BASE_URL，不新增前端平台开关。
# AgentArts/AgentOS、上传地址、workspace 和平台凭证统一在后端 .env 配置。
