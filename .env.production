# 生产环境建议留空，统一走当前 Nginx 同源代理；Nginx 按 location 转发到 8000 或 AgentArts。
# 前端部署到 1.94.244.72、101.245.75.75 或其它机器时，这里都不需要写前端 IP。
VITE_API_BASE_URL=

# 默认跟随 VITE_API_BASE_URL。若 /v1/scopes 不在登录管理服务中，可单独指定或通过 Nginx 单独转发。
VITE_SCOPES_API_BASE_URL=

VITE_AGENT_SESSION_EXPIRE_MINUTES=720

# 生产环境：水印下载服务按原逻辑直接请求 11328，不通过当前 Nginx 映射。
# 最终请求地址：${VITE_WATERMARK_API_BASE_URL}/watermark/download
VITE_WATERMARK_API_BASE_URL=http://101.245.75.75:11328
