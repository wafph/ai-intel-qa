  "changes": [
    "fix initial raw-object mutations that did not update Vue UI",
    "after final SSE: convert then GET and validate DOCX before readiness",
    "preserve backend filename and reuse per-qaId Blob for download and parent transfer",
    "retry GET without reconverting; clear old file cache on reset",
    "vertical attachment/save/redraft layout; hide new-session and contract length/strength controls",
    "restore explicit IP development proxy targets"
  ],
  "id_contract": {
    "sessionId": "stable for all rounds in a page conversation; initialize on entry or credential change",
    "qaId": "new per round; passed as qa_id and used for attachment cache",
    "taskId": "backend execution ID per round",
    "requestId": "unique parent-save message ID, checked with sessionId/qaId/taskId in receipt"
  },
